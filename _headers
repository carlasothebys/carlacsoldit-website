/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# HTML pages — revalidate frequently for SEO freshness signals
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/index.html
  Cache-Control: public, max-age=1800, must-revalidate

# CSS & JS — long cache, fingerprinted in practice
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Images — long cache
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Sitemap & robots — short cache so crawlers always get fresh copy
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

# Favicon — never cache so updates show immediately
/favicon.ico
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/images/favicon-192.png
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/images/favicon.svg
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
